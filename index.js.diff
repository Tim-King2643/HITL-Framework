+// A note is { reviewer, reaction, text, postedAt }. reaction is one of
+// 'agree' | 'question' | 'flag' | null — a quick tag GiGi or Tim can add
+// with or without free text. Notes are append-only: no edit/delete yet,
+// same "working notes, not a formal record" spirit as everything else in
+// docs/wip/ — this can grow an edit/delete path later if it turns out to
+// be needed.
+async function handleSandboxApi(request, env, url) {
+  const reviewer = reviewerFromRequest(request);
+
+  if (url.pathname === '/sandbox-api/me') {
+    return json({ reviewer });
+  }
+
+  if (url.pathname === '/sandbox-api/notes-all' && request.method === 'GET') {
+    const scope = url.searchParams.get('scope') || 'pcf7';
+    if (!SANDBOX_SCOPES.has(scope)) return json({ error: 'unknown scope' }, { status: 400 });
+    const notes = await readSandboxNotes(env, scope);
+    return json({ reviewer, notes });
+  }
+
+  if (url.pathname === '/sandbox-api/notes' && request.method === 'GET') {
+    const scope = url.searchParams.get('scope') || 'pcf7';
+    const itemId = url.searchParams.get('itemId');
+    if (!SANDBOX_SCOPES.has(scope)) return json({ error: 'unknown scope' }, { status: 400 });
+    if (!itemId) return json({ error: 'itemId required' }, { status: 400 });
+    const notes = await readSandboxNotes(env, scope);
+    return json({ reviewer, notes: notes[itemId] || [] });
+  }
+
+  if (url.pathname === '/sandbox-api/note' && request.method === 'POST') {
+    if (!reviewer) return json({ error: 'not signed in as a recognized reviewer' }, { status: 401 });
+
+    let body;
+    try { body = await request.json(); } catch (e) { return json({ error: 'invalid JSON body' }, { status: 400 }); }
+    const scope = (body && body.scope) || 'pcf7';
+    const itemId = body && body.itemId;
+    const reaction = (body && body.reaction) ? String(body.reaction) : null;
+    const text = typeof (body && body.text) === 'string' ? body.text.slice(0, 2000) : '';
+
+    if (!SANDBOX_SCOPES.has(scope)) return json({ error: 'unknown scope' }, { status: 400 });
+    if (!itemId || typeof itemId !== 'string') return json({ error: 'itemId required' }, { status: 400 });
+    if (!REACTIONS.has(reaction)) return json({ error: 'unknown reaction' }, { status: 400 });
+    if (!text && !reaction) return json({ error: 'a note needs a reaction or some text' }, { status: 400 });
+
+    const allNotes = await readSandboxNotes(env, scope);
+    const entry = { reviewer, reaction, text, postedAt: new Date().toISOString() };
+    allNotes[itemId] = (allNotes[itemId] || []).concat([entry]);
+    await writeSandboxNotes(env, scope, allNotes);
+    return json({ ok: true, notes: allNotes[itemId] });
+  }
+
+  return json({ error: 'not found' }, { status: 404 });
+}
